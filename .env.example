# =============================================================================
# TGOS environment template
# Copy to .env  →  cp .env.example .env
# Never commit real secrets.
# =============================================================================

# --- App ---
APP_ENV=development
# Local UI only: set true so auth bypass can run in development on your machine.
# Ignored when NODE_ENV is not development, or on Vercel/CI. Never true in production.
DISABLE_AUTH=false
APP_NAME=TGOS

# --- Supabase (required for real auth + data) ---
# Remote project OR values printed by `supabase start`
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=

# --- URLs (local defaults) ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4700
WEB_APP_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4700

# --- Optional AI providers (not required for Phase 0) ---
ANTHROPIC_API_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me
CONTINUE_API_KEY=replace_me

# --- Stripe (not required until billing phase) ---
STRIPE_PUBLISHABLE_KEY=replace_me
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_STARTER_MONTHLY=replace_me
STRIPE_PRICE_STARTER_ANNUAL=replace_me
STRIPE_PRICE_PRO_MONTHLY=replace_me
STRIPE_PRICE_PRO_ANNUAL=replace_me
STRIPE_PRICE_BUSINESS_MONTHLY=replace_me
STRIPE_PRICE_BUSINESS_ANNUAL=replace_me
