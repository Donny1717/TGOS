# =============================================================================
# TGOS environment template
# Copy to .env  →  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# Never commit real secrets.
# =============================================================================

# --- App ---
APP_ENV=development

# LOCAL PRODUCT WORK (recommended until Google / production auth is ready):
#   DISABLE_AUTH=true   → open http://127.0.0.1:3000/dashboard with no login
# PRODUCTION / real users:
#   DISABLE_AUTH=false  → require Supabase session
DISABLE_AUTH=true

APP_NAME=TGOS

# --- Supabase (optional while DISABLE_AUTH=true; required for real auth later) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4700
WEB_APP_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:4700

# --- Optional AI / Stripe (not required for UI work) ---
ANTHROPIC_API_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENROUTER_API_KEY=replace_me
CONTINUE_API_KEY=replace_me
STRIPE_PUBLISHABLE_KEY=replace_me
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_STARTER_MONTHLY=replace_me
STRIPE_PRICE_STARTER_ANNUAL=replace_me
STRIPE_PRICE_PRO_MONTHLY=replace_me
STRIPE_PRICE_PRO_ANNUAL=replace_me
STRIPE_PRICE_BUSINESS_MONTHLY=replace_me
STRIPE_PRICE_BUSINESS_ANNUAL=replace_me
