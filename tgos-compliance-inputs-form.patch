+function toDecimalAmount(value: string) {
+  if (!value) return null;
+
+  const normalized = value.replace(/,/g, "");
+  if (!/^\d+(?:\.\d{1,2})?$/.test(normalized)) {
+    throw new Error("Values must be non-negative amounts with up to two decimal places.");
+  }
+
+  return Number(normalized);
+}
+
+function toPositiveDecimal(value: string) {
+  if (!value) return null;
+
+  const normalized = value.replace(/,/g, "");
+  if (!/^\d+(?:\.\d{1,2})?$/.test(normalized) || Number(normalized) <= 0) {
+    throw new Error("Contract years must be a positive number.");
+  }
+
+  return Number(normalized);
+}
+
+function toPlainDate(value: string) {
+  if (!value) return null;
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    throw new Error("Procurement commencement date must be a valid date.");
+  }
+
+  return value;
+}
