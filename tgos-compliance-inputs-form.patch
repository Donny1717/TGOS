+export async function updateTenderComplianceInputs(tenderId: string, organisationId: string, formData: FormData) {
+  const input = tenderComplianceInputSchema.parse({
+    annualValueIncVat: readField(formData, "annualValueIncVat"),
+    buyerType: readField(formData, "buyerType"),
+    contractYears: readField(formData, "contractYears"),
+    isHealthServiceProcurementEngland: readField(formData, "isHealthServiceProcurementEngland"),
+    procurementCommencedOn: readField(formData, "procurementCommencedOn"),
+    totalValueIncVat: readField(formData, "totalValueIncVat"),
+    vatBasis: readField(formData, "vatBasis"),
+  });
+  const { supabase, user } = await requireOrganisationMembership(organisationId, ["owner", "admin", "member"]);
+
+  const { error } = await supabase
+    .from("tenders")
+    .update({
+      annual_value_inc_vat: toDecimalAmount(input.annualValueIncVat),
+      buyer_type: input.buyerType || null,
+      contract_years: toPositiveDecimal(input.contractYears),
+      is_health_service_procurement_england: input.isHealthServiceProcurementEngland === "on",
+      procurement_commenced_on: toPlainDate(input.procurementCommencedOn),
+      total_value_inc_vat: toDecimalAmount(input.totalValueIncVat),
+      vat_basis: input.vatBasis || null,
+    })
+    .eq("id", tenderId)
+    .eq("organisation_id", organisationId);
+
+  if (error) {
+    throw new Error(
+      "The compliance inputs could not be saved. Confirm values are inclusive of VAT and taken from the tender documents, not estimated.",
+    );
+  }
+
+  await writeAuditEvent(organisationId, user.id, "tender_compliance_inputs_updated");
+  revalidatePath(`/dashboard/${organisationId}/tenders/${tenderId}/final-gate`);
+}
